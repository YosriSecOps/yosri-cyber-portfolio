              <label for="cSubject" data-i18n="contact.form.subject">Objet de l'opportunité</label>
              <input type="text" id="cSubject" name="subject" placeholder="Stage PFE 2027 / Mission d'Audit"
                data-i18n-ph="contact.form.subject.ph" required />
            </div>
            <div class="form-row">
              <label for="cMessage" data-i18n="contact.form.message">Détails de la mission</label>
              <textarea id="cMessage" name="message" rows="4"
                placeholder="Bonjour Yosri, votre profil a retenu notre attention concernant un rôle en..."
                data-i18n-ph="contact.form.message.ph" required></textarea>
            </div>

            <!-- Live Status Feedback Container -->
            <div id="formStatus" class="form-status" aria-live="polite"></div>

            <button type="submit" class="btn-primary" id="btnSubmitForm" aria-live="polite">
              <span class="btn-text" data-i18n="contact.form.submit">Envoyer le message →</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
