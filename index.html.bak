            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </span>
      </button>

      <a href="cv-yosri-hamdouni.pdf" class="btn-cv-header" download title="Télécharger mon CV (PDF)">
