        </div>

        <!-- Card 3 -->
        <div class="stat-card glass-panel stat-border-green">
          <div class="stat-icon-wrap stat-icon-green">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <div class="stat-info">
            <span class="stat-num">&lt;10s</span>
            <span class="stat-label" data-i18n="stat.soar">Réponse active SOAR à incident</span>
          </div>
        </div>

        <!-- Card 4 -->
        <div class="stat-card glass-panel stat-border-cyan">
          <div class="stat-icon-wrap stat-icon-cyan">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
              <polyline points="16 7 22 7 22 13"></polyline>
