  <!-- ═══════════════════════════════════════════
       SECTION 1 — HERO & COMMAND CENTER (DOCKED DUAL HUD)
  ═══════════════════════════════════════════ -->
  <section class="hero" id="hero">
    <div class="container hero-container">

      <!-- ASYMMETRICAL DOCKED HUD GRID: LEFT IDENTITY + RIGHT TERMINAL -->
      <div class="hero-dock-grid">

        <!-- LEFT RAIL: Identity, Philosophy, CTA & Proof -->
        <div class="hero-left-dock">
          <div class="hero-identity glass-panel">
            <div class="hero-status-pill">
              <span class="status-dot-green"></span> <span data-i18n="hero.badge">Cyber Security Engineer</span>
            </div>

            <h1 class="hero-title">
              <span class="name-first">HAMDOUNI</span> <span class="name-last">YOSRI</span><span
                class="hero-cursor">_</span>
            </h1>

            <p class="hero-tagline" data-i18n="hero.tagline">
              Comprendre l’<span class="hl-cyan">attaque</span>. Construire la <span class="hl-blue">défense</span>.
            </p>

            <p class="hero-sub" data-i18n="hero.sub">
              Audit des risques · Sécurité offensive · Cyberdéfense.<br>
              Une approche de terrain, du signal à l’action.
            </p>

            <!-- Action Buttons -->
            <div class="hero-actions">
              <a href="#projets" class="btn-hero-primary" data-i18n="hero.explore">
                Explorer mes projets →
              </a>
              <a href="#contact" class="btn-hero-secondary" data-i18n="hero.contact">
                <span class="btn-prompt">&gt;_</span> Me contacter
              </a>
              <a href="cv-yosri-hamdouni.pdf" class="btn-hero-cv" download>
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"
                  style="vertical-align:-2px;margin-right:4px;">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span data-i18n="hero.cv">CV (PDF)</span>
              </a>
            </div>
          </div>
        </div>

        <!-- RIGHT RAIL: Live Terminal Initialization Box (Glass Cyber Shell) -->
        <div class="hero-right-dock">
          <div class="hero-terminal glass-panel" id="heroTerminal">
            <div class="terminal-bar">
              <div class="term-dots">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
              </div>
              <span class="terminal-title">root@yosri:~/secops — SESSION_INIT</span>
              <span class="terminal-video-pill">
                <span class="v-dot"></span> SEC//ACTIVE
              </span>
            </div>
            <div class="terminal-body">
              <div class="term-line"><span class="prompt">root@yosri:~$</span> <span class="cmd-text">whoami</span>
              </div>
              <div class="term-res">
                <p class="res-highlight" data-i18n="hero.term.res">&gt; CYBERSECURITY ENGINEER IN THE MAKING</p>
                <div class="res-list">
                  <span class="res-item" data-i18n="hero.term.audit"><span class="chk-ok">[ OK ]</span> Audit &amp;
                    Gouvernance (ISO 27001 Lead Auditor, RHCSA)</span>
                  <span class="res-item" data-i18n="hero.term.offensive"><span class="chk-ok">[ OK ]</span> Sécurité
                    Offensive (eCPPT v2, AD Pentest, Root Access)</span>
                  <span class="res-item" data-i18n="hero.term.defense"><span class="chk-ok">[ OK ]</span> Défense SOC
                    &amp; DFIR (Wazuh, Sentinel, SOAR &lt;10s)</span>
                </div>
              </div>
              <div class="term-line"><span class="prompt">root@yosri:~$</span> <span class="cmd-text">status --target
                  pfe-2027</span></div>
              <div class="term-res">
                <p class="res-meta" data-i18n="hero.term.pfe">&gt; Stage PFE 6 mois · Tunisie &amp; International</p>
                <p class="res-meta text-cyan" data-i18n="hero.term.mobility">&gt; Mobilité active · Opérationnel
                  immédiatement</p>
                <span class="cursor-underscore">_</span>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- 4 FULL-WIDTH HORIZONTAL GLASS STATISTICS CARDS (REFERENCE DESIGN) -->
      <div class="hero-stats-row reveal">
        <!-- Card 1 -->
        <div class="stat-card glass-panel stat-border-blue">
          <div class="stat-icon-wrap stat-icon-blue">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
