          </div>
          <form class="contact-form" id="contactForm" action="https://formspree.io/f/xpppvzwr" method="POST">
            <!-- Anti-spam Honeypot Field -->
            <input type="text" name="_gotcha" class="form-honeypot" style="display:none !important;" tabindex="-1"
              autocomplete="off" />

            <div class="form-row">
              <label for="cName" data-i18n="contact.form.name">Votre nom &amp; entreprise</label>
              <input type="text" id="cName" name="name" placeholder="Ex: Jean Dupont (RSSI / Talent Partner)"
                data-i18n-ph="contact.form.name.ph" required />
            </div>
            <div class="form-row">
              <label for="cEmail" data-i18n="contact.form.email">Votre adresse email</label>
              <input type="email" id="cEmail" name="email" placeholder="nom@entreprise.com"
                data-i18n-ph="contact.form.email.ph" required />
            </div>
