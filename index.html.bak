  <!-- ═══════════════════════════════════════════
       SECTION 1 — PROFIL (01 / 07)
  ═══════════════════════════════════════════ -->
  <section class="section" id="profil">
    <div class="container">

      <div class="section-header reveal">
        <span class="section-tag" data-i18n="profil.tag">01 / 07 · PROFIL</span>
