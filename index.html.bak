        <!-- PROJET 5 : VMS-Edge -->
        <div class="project-card reveal" data-category="defense" style="grid-column: 1 / -1;">
          <div class="project-banner">
            <div class="project-status live">
              <span class="status-dot"></span> <span data-i18n="p5.status">PROJET PERSONNEL</span>
            </div>
          </div>
          <div class="project-body">
            <div class="project-num" data-i18n="p5.num">PROJET 05/05 · SURVEILLANCE &amp; FORENSIQUE</div>
            <h3 class="project-title">VMS-Edge</h3>
            <p class="project-tagline" data-i18n="p5.tagline">Détecter. Alerter. Prouver.</p>
            <p class="project-desc" data-i18n="p5.desc">
              Plateforme de vidéosurveillance multi-caméras en Python : détection (<strong>Haar Cascade</strong>) et
              reconnaissance faciale (<strong>LBPH</strong>) par flux, alertes <strong>Telegram</strong> avec anti-spam
              (cooldown 15 s) et tatouage numérique <strong>DCT</strong> des captures pour la traçabilité des preuves.
            </p>
            <div class="project-metric-pill">
              <span class="pill-label" data-i18n="p5.pill.label">Traçabilité des preuves :</span>
