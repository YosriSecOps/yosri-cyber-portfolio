  <!-- ═══════════════════════════════════════════
       SECTION 6 — TERMINAL CLI (06 / 07)
  ═══════════════════════════════════════════ -->
  <section class="section" id="terminal">
    <div class="container">

      <div class="section-header reveal">
        <span class="section-tag" data-i18n="terminal.tag">06 / 07 · TERMINAL</span>
        <h2 class="section-title" data-i18n="terminal.title">Explorez mon profil en <span class="accent">ligne de
            commande</span>.</h2>
        <p class="section-sub" data-i18n="terminal.sub">Pas de scan intrusif. Pas de magie. Juste mon profil, version
          terminal interactive.</p>
      </div>

      <div class="terminal-wrapper reveal">
        <div class="interactive-terminal" id="interactiveTerminal">
          <div class="terminal-bar">
            <div class="term-dots">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
            </div>
            <span class="terminal-title">yosri@secops:~ (bash interactive shell)</span>
            <span class="term-status-badge">ONLINE</span>
          </div>

          <div class="terminal-screen" id="terminalScreen">
            <div class="term-banner">
              <pre class="ascii-art">
 __   _____  ____  ____  ___   _   _    _    __  __ ____   ___  _   _ _   _ ___ 
 \ \ / / _ \/ ___||  _ \|_ _| | | | |  / \  |  \/  |  _ \ / _ \| | | | \ | |_ _|
  \ V / | | \___ \| |_) || |  | |_| | / _ \ | |\/| | | | | | | | | | |  \| || | 
   | || |_| |___) |  _ &lt; | |  |  _  |/ ___ \| |  | | |_| | |_| | |_| | |\  || | 
   |_| \___/|____/|_| \_\___| |_| |_/_/   \_\_|  |_|____/ \___/ \___/|_| \_|___|
              </pre>
              <div class="ascii-title-bar">&gt; YOSRI HAMDOUNI &middot; SECOPS COMMAND SHELL</div>
              <p class="term-welcome" data-i18n="terminal.welcome">Bienvenue sur le shell interactif de <strong>Yosri
                  Hamdouni</strong>.</p>
              <p class="term-hint" data-i18n="terminal.hint">Tapez <span class="cmd-pill">help</span> pour afficher la
                liste des commandes ou cliquez sur les suggestions ci-dessous :</p>

              <div class="quick-cmds">
                <button class="quick-cmd-btn" data-cmd="whoami">whoami</button>
                <button class="quick-cmd-btn" data-cmd="projects">projects</button>
                <button class="quick-cmd-btn" data-cmd="certs">certs</button>
                <button class="quick-cmd-btn" data-cmd="parcours">parcours</button>
                <button class="quick-cmd-btn" data-cmd="skills">skills</button>
                <button class="quick-cmd-btn" data-cmd="cv">cv</button>
                <button class="quick-cmd-btn" data-cmd="contact">contact</button>
                <button class="quick-cmd-btn" data-cmd="audit">audit</button>
                <button class="quick-cmd-btn" data-cmd="clear">clear</button>
              </div>
            </div>

            <div id="termLogs"></div>

            <div class="term-input-line">
              <span class="term-prompt">yosri@secops ~ $</span>
              <input type="text" id="termInput" class="term-input" autocomplete="off" spellcheck="false" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

