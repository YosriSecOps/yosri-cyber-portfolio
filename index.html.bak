  <title>Yosri Hamdouni · Cybersecurity Engineer &amp; Consultant | Command Center</title>
  <meta name="description"
    content="Portfolio cybersécurité de Yosri Hamdouni — Élève-ingénieur TEK-UP (3A), certifié ISO 27001 Lead Auditor, eCPPT v2, SC-200, Splunk & RHCE. Concepteur de CyberScore TN (ANCS) et Smart SOC. Expérience cinématique scroll-driven." />
  <meta name="author" content="Yosri Hamdouni" />
  <meta name="theme-color" content="#030712" />

  <!-- OpenGraph -->
  <meta property="og:title" content="Yosri Hamdouni · Cybersecurity Engineer & Consultant" />
  <meta property="og:description"
    content="Comprendre l’attaque. Construire la défense. Audit des risques, Sécurité offensive & Cyberdéfense." />
  <meta property="og:type" content="website" />

  <!-- Fonts: JetBrains Mono + Inter + Syne -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
