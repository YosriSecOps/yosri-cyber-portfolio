      <div class="profile-grid">

        <!-- Radar Chart Card -->
        <div class="profile-visual reveal">
          <div class="radar-card">
            <div class="radar-header">
              <span class="radar-title" data-i18n="profil.radar.title">MATRICE DES COMPÉTENCES OPÉRATIONNELLES</span>
              <span class="radar-badge">HEXAGONAL RADAR</span>
            </div>
            <div class="radar-canvas-wrap">
              <canvas id="radarCanvas" width="340" height="340"></canvas>
